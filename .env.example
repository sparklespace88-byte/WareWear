# GEMINI_API_KEY: Optional for AI integrations.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign session tokens (auto-generated in-memory fallback if omitted).
SESSION_SECRET=

# ADMIN_PASSCODE: Optional passcode for claiming or authenticating admin access.
ADMIN_PASSCODE=
